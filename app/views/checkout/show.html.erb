<div class="max-w-lg mx-auto text-center space-y-6 py-12 px-4">
  <div class="w-16 h-16 rounded-full bg-success-100 flex items-center justify-center mx-auto text-success-600">
    <%= render "shared/svg/checkmark", class: "w-8 h-8" %>
  </div>

  <div>
    <h1 class="text-2xl font-bold text-foreground">Payment successful</h1>
    <p class="text-muted-foreground mt-2">
      Your subscription for <strong><%= @workspace.name %></strong> is being activated. This usually takes just a few seconds.
    </p>
  </div>

  <%= link_to "Go to Billing", workspace_billing_path(@workspace), class: "ui-btn-primary ui-btn-lg" %>
</div>
