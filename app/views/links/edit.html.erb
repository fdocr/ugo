<div class="mx-auto max-w-2xl space-y-6 px-4">
  <%= form_with(url: workspace_link_path(@workspace.id, @link.slug), class: "space-y-4", method: :patch) do |form| %>
    <%= render "ui/input", form: form, field: :name, label: "Name",
          value: @link.name,
          placeholder: "January 2025 SMS campaign..." %>

    <%= render "ui/textarea", form: form, field: :comments, label: "Comments",
          value: @link.comments,
          placeholder: "Add notes or description...", rows: 3 %>

    <div class="flex gap-3 max-w-96 mx-auto">
      <%= link_to "Cancel", workspace_link_path(@workspace.id, @link.slug), class: "ui-btn-secondary ui-btn-md flex-1" %>
      <%= form.submit "Update Link", class: "ui-btn-primary ui-btn-md flex-1" %>
    </div>
  <% end %>
</div>
