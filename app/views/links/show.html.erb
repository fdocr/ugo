<div class="space-y-6 mx-auto w-full max-w-5xl px-4 sm:px-6" data-controller="tabs" data-tabs-default-value="analytics">
  <%= render "ui/card" do %>
    <!-- Header with link info and actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
      <%= render "shared/link", link: @link %>
      <div class="flex items-center gap-2 flex-shrink-0">
        <%= link_to edit_workspace_link_path(@workspace.id, @link.slug), class: "ui-btn-primary ui-btn-sm" do %>
          <%= render "shared/svg/edit", class: "w-4 h-4" %>
          <span>Edit</span>
        <% end %>
        <%= button_to workspace_link_path(@workspace.id, @link.slug),
              method: :delete,
              form: { data: { turbo_confirm: "Are you sure you want to delete this link?" } },
              class: "ui-btn-danger ui-btn-sm" do %>
          <%= render "shared/svg/delete", class: "w-4 h-4" %>
          <span>Delete</span>
        <% end %>
      </div>
    </div>

    <!-- Tab Navigation -->
    <div class="border-b border-border mb-6">
      <nav class="flex gap-6 -mb-px">
        <button data-tabs-target="tab" data-tab="analytics" data-action="tabs#select" data-state="active" class="ui-tab">
          Analytics
        </button>
        <button data-tabs-target="tab" data-tab="utm_builder" data-action="tabs#select" class="ui-tab">
          URL Builder
        </button>
        <button data-tabs-target="tab" data-tab="details" data-action="tabs#select" class="ui-tab">
          Details
        </button>
      </nav>
    </div>

    <!-- Analytics Panel -->
    <div data-tabs-target="panel" data-tab="analytics">
      <%= turbo_frame_tag "visits-chart", src: workspace_link_visits_path(@workspace.id, @link.slug), loading: :lazy do %>
        <%= render "ui/loading", label: "Loading analytics…" %>
      <% end %>
    </div>

    <!-- URL Builder Panel -->
    <div data-tabs-target="panel" data-tab="utm_builder" class="hidden">
      <% cache [ @link, "utm_builder", @link.url ] do %>
        <%= render "links/utm_builder", link: @link, workspace: @workspace %>
      <% end %>
    </div>

    <!-- Details Panel -->
    <div data-tabs-target="panel" data-tab="details" class="hidden">
      <div class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="ui-label">Name</label>
            <div class="ui-input-readonly">
              <%= @link.name.present? ? @link.name : "Unnamed Link" %>
            </div>
          </div>

          <div class="space-y-2">
            <label class="ui-label">URL</label>
            <% if @link.url.present? %>
              <div class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm overflow-x-auto whitespace-nowrap text-foreground">
                <%= @link.url %>
              </div>
            <% else %>
              <div class="ui-input-readonly">No URL set</div>
            <% end %>
          </div>

          <div class="space-y-2">
            <label class="ui-label">Comments</label>
            <div class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm min-h-[80px] text-foreground">
              <%= @link.comments.present? ? simple_format(@link.comments) : "No comments" %>
            </div>
          </div>

          <div class="space-y-2">
            <label class="ui-label">Workspace</label>
            <div class="ui-input-readonly"><%= @workspace.name %></div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-border">
          <div class="space-y-2">
            <%
              social_tag = @link.social_tag
              cooldown_active = social_tag.present? && social_tag.updated_at >= SocialTag::REFRESH_COOLDOWN.ago
              minutes_remaining = cooldown_active ? ((social_tag.updated_at + SocialTag::REFRESH_COOLDOWN - Time.current) / 60.0).ceil : 0
            %>
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <label class="ui-label mb-0">Social Preview</label>
              <% if social_tag.present? %>
                <%= button_to social_tag_workspace_link_path(@workspace.id, @link.slug),
                      method: :put,
                      disabled: cooldown_active,
                      title: (cooldown_active ? "Available again in #{minutes_remaining} minute#{'s' if minutes_remaining != 1}" : "Refresh social preview"),
                      aria: { label: "Refresh social preview" },
                      class: "ui-btn-secondary ui-btn-sm w-full sm:w-auto justify-center",
                      form: { class: "w-full sm:w-auto" } do %>
                  <%= render "shared/svg/arrow_path", class: "w-4 h-4" %>
                  <span>Refresh</span>
                <% end %>
              <% end %>
            </div>

            <% cache social_tag do %>
              <% if social_tag.present? %>
                <div class="border border-border rounded-lg overflow-hidden bg-white">
                  <% if social_tag.image_url.present? %>
                    <img src="<%= social_tag.image_url %>" alt="" class="w-full h-48 object-cover">
                  <% end %>
                  <div class="p-4">
                    <div class="text-xs text-muted-foreground uppercase tracking-wide mb-1">
                      <%= link_host(@link.url) %>
                    </div>
                    <h3 class="font-medium text-base line-clamp-2 mb-1 text-foreground">
                      <%= social_tag.title %>
                    </h3>
                    <p class="text-sm text-muted-foreground line-clamp-2">
                      <%= social_tag.description %>
                    </p>
                  </div>
                </div>
              <% else %>
                <% fetch_button = capture do %>
                  <%= button_to social_tag_workspace_link_path(@workspace.id, @link.slug),
                        method: :put,
                        class: "ui-btn-primary ui-btn-sm" do %>
                    <%= render "shared/svg/arrow_path", class: "w-4 h-4" %>
                    <span>Fetch social preview</span>
                  <% end %>
                <% end %>
                <div class="border border-border rounded-lg bg-muted/30">
                  <%= render "ui/empty_state",
                        icon: "share_nodes",
                        title: "No social preview yet",
                        body: "We'll fetch the title, description, and image from your destination URL.",
                        compact: true,
                        action: fetch_button %>
                </div>
              <% end %>
            <% end %>

            <div class="mt-3 text-sm text-muted-foreground">
              <p>The final rendering on each platform might vary. Validate your url using:</p>
              <div class="mt-2 flex flex-col gap-1">
                <a href="https://developers.facebook.com/tools/debug/?q=<%= @link.url %>" target="_blank" rel="noopener" class="ui-btn-link">
                  • Facebook Sharing Debugger
                </a>
                <a href="https://www.opengraph.xyz/url/<%= ERB::Util.url_encode(@link.url) %>" target="_blank" rel="noopener" class="ui-btn-link">
                  • OpenGraph.xyz Validator
                </a>
              </div>
            </div>
          </div>

          <div class="space-y-2"
               data-controller="qr-share"
               data-qr-share-link-slug-value="<%= @link.slug %>"
               data-qr-share-link-name-value="<%= @link.name %>">
            <label class="ui-label">QR Code</label>
            <% if @link.qr_code.present? %>
              <div class="relative border border-border rounded-lg overflow-hidden bg-white p-4 flex items-center justify-center group">
                <div data-qr-share-target="qrCode" class="w-full max-w-[240px] [&>svg]:w-full [&>svg]:h-auto">
                  <%= @link.qr_code.html_safe %>
                </div>

                <div class="absolute top-2 right-2 flex gap-2 opacity-0 group-hover:opacity-100 transition-all duration-200">
                  <button data-action="click->qr-share#download"
                          class="p-2 bg-white/90 backdrop-blur-sm rounded-md shadow-popover hover:bg-white hover:scale-110 transition-all duration-200"
                          title="Download QR Code">
                    <%= render "shared/svg/download", class: "w-8 h-8 text-primary-600" %>
                  </button>
                  <button data-action="click->qr-share#share"
                          class="p-2 bg-white/90 backdrop-blur-sm rounded-md shadow-popover hover:bg-white hover:scale-110 transition-all duration-200"
                          title="Share QR Code">
                    <%= render "shared/svg/share", class: "w-8 h-8 text-primary-600" %>
                  </button>
                </div>
              </div>
            <% else %>
              <div class="p-4 border border-border rounded-lg bg-muted/30">
                <div class="flex items-center gap-3 text-muted-foreground">
                  <%= render "shared/svg/info", class: "h-5 w-5" %>
                  <p class="text-sm">No QR code available for this link.</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-border">
          <div class="space-y-2">
            <label class="ui-label text-muted-foreground">Created</label>
            <div class="text-sm text-foreground">
              <%= @link.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </div>
          </div>
          <div class="space-y-2">
            <label class="ui-label text-muted-foreground">Last Updated</label>
            <div class="text-sm text-foreground">
              <%= @link.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
