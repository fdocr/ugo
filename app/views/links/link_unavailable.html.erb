<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Link unavailable</title>
  <style>
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .fade-in {
      opacity: 0;
      animation: fadeIn 0.4s ease-in-out 0.3s forwards;
    }
  </style>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f9fafb; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: flex-start;">

  <div class="fade-in" style="margin-top: 15vh; width: 100%; max-width: 24rem; padding: 0 1.5rem; text-align: center;">
    <div style="width: 48px; height: 48px; border-radius: 50%; background: #fef2f2; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" stroke="#dc2626" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p style="font-size: 1.125rem; font-weight: 600; color: #111827; margin: 0 0 0.5rem;">This short link is unavailable</p>
    <p style="font-size: 0.875rem; color: #6b7280; margin: 0; line-height: 1.5;">The workspace owner needs an active subscription to keep links working.</p>
  </div>

</body>
</html>
