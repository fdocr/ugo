<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Redirecting...</title>

  <% cache @link.social_tag do %>
    <!-- Primary Meta Tags -->
    <% if @link.social_tag.present? %>
      <meta name="title" content="<%= @link.social_tag.title %>">
      <meta name="description" content="<%= @link.social_tag.description %>">

      <!-- Open Graph / Facebook -->
      <meta property="og:type" content="website">
      <meta property="og:url" content="<%= @link.social_tag.url %>">
      <meta property="og:title" content="<%= @link.social_tag.title %>">
      <meta property="og:description" content="<%= @link.social_tag.description %>">
      <meta property="og:image" content="<%= @link.social_tag.image_url %>">

      <!-- Twitter -->
      <meta property="twitter:card" content="summary_large_image">
      <meta property="twitter:url" content="<%= @link.social_tag.url %>">
      <meta property="twitter:title" content="<%= @link.social_tag.title %>">
      <meta property="twitter:description" content="<%= @link.social_tag.description %>">
      <meta property="twitter:image" content="<%= @link.social_tag.image_url %>">
    <% else %>
      <meta name="title" content="<%= @link.name %>">
      <meta name="description" content="">
    <% end %>
  <% end %>

  <% cache @link do %>
    <link rel="canonical" href="<%= @link.url %>">

    <script>
      window.location.replace(<%== @link.url.to_json %>);
    </script>
  <% end %>
</head>

<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f9fafb; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: flex-start;">
  
  <style>
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    
    .fade-in-delayed {
      opacity: 0;
      animation: fadeIn 0.3s ease-in-out 0.8s forwards;
    }
    
    .spinner {
      opacity: 0;
      animation: fadeIn 0.3s ease-in-out 0.8s forwards;
    }
    
    .spinner svg {
      animation: spin 1s linear infinite;
    }
  </style>

  <!-- Spinner -->
  <div class="spinner" style="margin-top: 15vh;">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" stroke="#e5e7eb" stroke-width="2"/>
      <path d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" fill="#5aa9e6"/>
    </svg>
  </div>

  <!-- Button -->
  <div style="margin-top: 20vh; width: 100%; display: flex; justify-content: center;">
    <a href="<%= @link.url %>" 
       class="fade-in-delayed"
       style="display: inline-block; background: linear-gradient(135deg, #5aa9e6 0%, #3b8fd8 100%); color: white; text-decoration: none; padding: 16px 32px; border-radius: 12px; font-size: 18px; font-weight: 600; box-shadow: 0 4px 16px rgba(90, 169, 230, 0.3); transition: all 0.2s ease; border: none; cursor: pointer;">
      Take me to my destination
    </a>
  </div>

</body>

</html>