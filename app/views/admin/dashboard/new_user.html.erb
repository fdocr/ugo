<div class="max-w-lg mx-auto space-y-6 px-4">
  <div class="space-y-2">
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">Create User</h2>
    <p class="text-sm text-muted-foreground">
      A random password will be generated and sent to the user's email address.
      They will be able to change it after signing in.
    </p>
  </div>

  <%= render "ui/card" do %>
    <%= form_with url: admin_create_user_path, method: :post, class: "space-y-5" do |form| %>
      <%= render "ui/input",
            form: form, field: :email, type: :email, label: "Email Address",
            required: true, autofocus: true, autocomplete: "off",
            placeholder: "user@example.com" %>

      <div class="flex items-center gap-3">
        <%= form.submit "Create User & Send Credentials", class: "ui-btn-primary ui-btn-md" %>
        <%= link_to "Cancel", admin_root_path, class: "text-sm text-muted-foreground hover:text-foreground transition-colors" %>
      </div>
    <% end %>
  <% end %>
</div>
