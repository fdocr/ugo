<div class="min-h-[60vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <%= render "ui/card", padding: :lg do %>
      <div class="space-y-2 text-center mb-8">
        <h1 class="text-2xl font-semibold tracking-tight text-foreground">Change Password</h1>
        <p class="text-sm text-muted-foreground">Update your account password.</p>
      </div>

      <%= form_with url: update_account_password_path, method: :patch, class: "space-y-5" do |form| %>
        <%= render "ui/input",
              form: form, field: :current_password, type: :password, label: "Current Password",
              placeholder: "••••••••",
              required: true, autocomplete: "current-password" %>

        <%= render "ui/input",
              form: form, field: :password, type: :password, label: "New Password",
              placeholder: "••••••••",
              required: true, autocomplete: "new-password",
              minlength: 8, maxlength: 72,
              hint: "Must be at least 8 characters." %>

        <%= render "ui/input",
              form: form, field: :password_confirmation, type: :password, label: "Confirm New Password",
              placeholder: "••••••••",
              required: true, autocomplete: "new-password",
              minlength: 8, maxlength: 72 %>

        <%= form.submit "Update Password", class: "ui-btn-primary ui-btn-md w-full" %>
      <% end %>
    <% end %>

    <p class="text-center text-sm text-muted-foreground mt-6">
      <%= link_to "Back to Dashboard", dashboard_path, class: "ui-btn-link" %>
    </p>
  </div>
</div>
