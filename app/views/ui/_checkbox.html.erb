<%# locals: (form: nil, field: nil, label:, description: nil, checked: nil, disabled: false) %>
<label class="flex items-start gap-3 <%= disabled ? "cursor-not-allowed opacity-50" : "cursor-pointer" %>">
  <% if form && field %>
    <%= form.check_box field, { checked: checked, disabled: disabled, class: "ui-checkbox mt-0.5" } %>
  <% else %>
    <input type="checkbox" disabled class="ui-checkbox mt-0.5">
  <% end %>
  <div class="min-w-0">
    <span class="text-sm font-medium text-foreground"><%= label %></span>
    <% if description.present? %>
      <p class="text-xs text-muted-foreground"><%= description %></p>
    <% end %>
  </div>
</label>
