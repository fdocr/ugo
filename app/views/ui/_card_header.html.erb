<%# locals: (title:, description: nil, actions: nil, padded: true) %>
<div class="<%= padded ? "flex items-start justify-between gap-4 mb-4" : "flex items-start justify-between gap-4" %>">
  <div class="min-w-0">
    <h3 class="text-lg font-semibold text-foreground"><%= title %></h3>
    <% if description.present? %>
      <p class="text-sm text-muted-foreground mt-1"><%= description %></p>
    <% end %>
  </div>
  <% if actions.present? %>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%= actions %>
    </div>
  <% end %>
</div>
