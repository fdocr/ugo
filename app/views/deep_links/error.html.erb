<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Redirect unavailable</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f9fafb; min-height: 100vh; display: flex; align-items: flex-start; justify-content: center;">
  <div style="margin-top: 15vh; width: 100%; max-width: 24rem; padding: 0 1.5rem; text-align: center;">
    <p style="font-size: 1.125rem; font-weight: 600; color: #111827; margin: 0 0 0.5rem;">Redirect unavailable</p>
    <p style="font-size: 0.875rem; color: #6b7280; margin: 0; line-height: 1.5;"><%= h(@error_message) %></p>
  </div>
</body>
</html>
