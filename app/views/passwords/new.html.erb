<div class="min-h-[70vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <%= render "ui/card", padding: :lg do %>
      <div class="space-y-2 text-center mb-8">
        <h1 class="text-2xl font-semibold tracking-tight text-foreground">Reset your password</h1>
        <p class="text-sm text-muted-foreground">Enter your email and we'll send you instructions</p>
      </div>

      <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
        <%= render "ui/input",
              form: form, field: :email, type: :email, label: "Email",
              placeholder: "name@example.com",
              value: params[:email],
              required: true, autofocus: true, autocomplete: "username" %>

        <%= render "shared/turnstile", action: "forgot_password" %>

        <%= form.submit "Send instructions", class: "ui-btn-primary ui-btn-md w-full" %>
      <% end %>
    <% end %>

    <p class="text-center text-sm text-muted-foreground mt-6">
      Remember your password?
      <%= link_to "Sign in", new_session_path, class: "ui-btn-link" %>
    </p>
  </div>
</div>
