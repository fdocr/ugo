<div class="min-h-[70vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <%= render "ui/card", padding: :lg do %>
      <div class="space-y-2 text-center mb-8">
        <h1 class="text-2xl font-semibold tracking-tight text-foreground">Create an account</h1>
        <p class="text-sm text-muted-foreground">Get started with your free account</p>
      </div>

      <%= form_with url: sign_up_path, class: "space-y-5" do |form| %>
        <%= render "ui/input",
              form: form, field: :email, type: :email, label: "Email",
              placeholder: "name@example.com",
              value: params[:email],
              required: true, autofocus: true, autocomplete: "email" %>

        <%= render "ui/input",
              form: form, field: :password, type: :password, label: "Password",
              placeholder: "••••••••",
              required: true, autocomplete: "new-password",
              minlength: 8, maxlength: 72,
              hint: "Must be at least 8 characters" %>

        <%= render "ui/input",
              form: form, field: :password_confirmation, type: :password, label: "Confirm password",
              placeholder: "••••••••",
              required: true, autocomplete: "new-password",
              minlength: 8, maxlength: 72 %>

        <%= render "shared/turnstile", action: "signup" %>

        <%= form.submit "Create account", class: "ui-btn-primary ui-btn-md w-full" %>
      <% end %>
    <% end %>

    <p class="text-center text-sm text-muted-foreground mt-6">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "ui-btn-link" %>
    </p>
  </div>
</div>
