<div class="space-y-6 mx-auto w-full max-w-5xl px-4 sm:px-6">
  <div>
    <p class="text-muted-foreground">
      Manage your account and preferences
    </p>
  </div>

  <%= render "home/pending_invitations" %>

  <% if !self_hosted? && Current.user.workspaces.any?(&:trial?) %>
    <%= render "ui/banner",
          tone: :warning,
          title: "Trial in progress",
          body: "You have #{pluralize(Current.user.workspaces.select(&:trial?).size, "workspace")} on a free Basic trial. Open a workspace below for the countdown and subscribe anytime.".html_safe %>
  <% end %>

  <%= render "ui/card", padding: :none do %>
    <div class="flex flex-col gap-6 p-6">
      <div class="space-y-1">
        <h3 class="font-medium leading-none text-foreground">Email</h3>
        <div class="flex items-center gap-2">
          <p class="text-sm text-muted-foreground"><%= Current.user.email %></p>
          <% if Current.user.site_admin? %>
            <%= render "ui/badge", text: "Site Admin", tone: :info %>
          <% end %>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-2">
        <%= link_to edit_account_password_path, class: "ui-btn-secondary ui-btn-sm" do %>
          <%= render "shared/svg/lock", class: "w-4 h-4" %>
          Change Password
        <% end %>
        <% if Current.user.site_admin? %>
          <%= link_to admin_root_path, class: "ui-btn-secondary ui-btn-sm" do %>
            <%= render "shared/svg/gear", class: "w-4 h-4" %>
            Site Admin
          <% end %>
        <% end %>
      </div>
      <div class="space-y-4">
        <h3 class="font-medium leading-none text-foreground">Workspaces</h3>
        <div id="workspaces_list" class="space-y-3">
          <% Current.user.workspaces.each do |workspace| %>
            <%= render "home/workspace_item", workspace: workspace %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render "ui/card" do %>
    <h3 class="text-lg font-semibold mb-4 text-foreground">Your Links</h3>
    <%= turbo_frame_tag "dashboard-links", src: dashboard_links_path, loading: :lazy do %>
      <%= render "ui/loading", label: "Loading links…" %>
    <% end %>
  <% end %>

  <%= render "ui/card", tone: :danger do %>
    <h3 class="text-lg font-semibold text-danger-700 mb-2">Delete Account</h3>
    <p class="text-sm text-muted-foreground mb-4">
      This action will permanently delete your account and all associated data.
      Once deleted, you won't be able to recover any information.
    </p>

    <div class="flex justify-end">
      <%= button_to sign_up_path,
            method: :delete,
            form: { data: { turbo_confirm: "Are you sure? This action cannot be undone and will permanently delete all your data." } },
            class: "ui-btn-danger ui-btn-md" do %>
        <%= render "shared/svg/delete" %>
        <span>Delete my account</span>
      <% end %>
    </div>
  <% end %>
</div>
