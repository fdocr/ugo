<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= @page_title || AppConfig.shared.app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="language" content="en">
    <meta name="description" content="Shorten links, track engagement, and own your data.">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <% if AppConfig.shared.admin_scripts.present? %>
      <%= AppConfig.shared.admin_scripts.html_safe %>
    <% end %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path('ugo_logo_favicon.png') %>" type="image/png">
    <link rel="icon" href="<%= asset_path('ugo_logo_favicon.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('ugo_logo_favicon.png') %>">

    <!-- Social Media Meta Tags -->
    <meta property="og:title" content="ugo.cr">
    <meta property="og:description" content="ugo is a link shortener & more">
    <meta property="og:image" content="<%= asset_url('ugo_logo.png') %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:type" content="website">

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="ugo.cr">
    <meta name="twitter:description" content="ugo is a link shortener & more">
    <meta name="twitter:image" content="<%= asset_url('ugo_logo.png') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%# Vendored chart libraries (loaded as globals before importmap) %>
    <%= javascript_include_tag "apexcharts.min", nonce: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "d3.v3.min", nonce: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "topojson.v1.min", nonce: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "datamaps.world.min", nonce: true, "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/nav" unless @hide_nav %>

    <main class="max-w-7xl mx-auto mt-12 pb-16">
      <div id="flash">
        <%= render partial: "shared/flash" %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
