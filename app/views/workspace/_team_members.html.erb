<%# Current Members %>
<div class="space-y-3">
  <h4 class="text-sm font-medium text-muted-foreground">Members</h4>
  <div class="space-y-2">
    <% workspace.memberships.includes(:user).order(role: :desc, created_at: :asc).each do |membership| %>
      <div class="flex items-center justify-between p-3 rounded-md bg-muted/50">
        <div class="flex items-center gap-3 min-w-0">
          <%= render "ui/avatar", text: membership.user.email, tone: :primary %>
          <div class="min-w-0">
            <p class="text-sm font-medium text-foreground truncate"><%= membership.user.email %></p>
            <p class="text-xs text-muted-foreground capitalize"><%= membership.role %></p>
          </div>
        </div>
        <% if workspace_admin? && membership.user != Current.user %>
          <%= button_to workspace_membership_path(workspace, membership),
                method: :delete,
                form: { data: { turbo_confirm: "Remove #{membership.user.email} from this workspace?" } },
                class: "ui-btn-ghost h-8 w-8 px-0 text-muted-foreground hover:text-danger-600",
                "aria-label": "Remove member" do %>
            <%= render "shared/svg/close", class: "w-4 h-4" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Pending Invitations %>
<% pending_invitations = workspace.invitations.pending %>
<% if pending_invitations.any? %>
  <div class="space-y-3 pt-4 border-t border-border mt-4">
    <h4 class="text-sm font-medium text-muted-foreground">Pending Invitations</h4>
    <div class="space-y-2">
      <% pending_invitations.each do |invitation| %>
        <div class="flex items-center justify-between p-3 rounded-md bg-warning-50 border border-warning-200">
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-8 h-8 rounded-full bg-warning-100 flex items-center justify-center text-warning-600 flex-shrink-0">
              <%= render "shared/svg/clock", class: "w-4 h-4" %>
            </span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-foreground truncate"><%= invitation.email %></p>
              <p class="text-xs text-muted-foreground">
                Invited as <%= invitation.role %> · Expires <%= time_ago_in_words(invitation.expires_at) %> from now
              </p>
            </div>
          </div>
          <% if workspace_admin? %>
            <%= button_to workspace_invitation_path(workspace, invitation),
                  method: :delete,
                  form: { data: { turbo_confirm: "Cancel invitation to #{invitation.email}?" } },
                  class: "ui-btn-ghost h-8 w-8 px-0 text-muted-foreground hover:text-danger-600",
                  "aria-label": "Cancel invitation" do %>
              <%= render "shared/svg/close", class: "w-4 h-4" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
