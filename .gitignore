# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except .env.sample).
/.env*
!/.env.sample

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Generated by rake sitemap:create
/public/sitemap.xml.gz
/public/sitemap*.xml.gz
/public/robots.txt

# Legacy — credentials are no longer used, but ignore the key if it lingers locally
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

# GeoLite2 database (downloaded via rake geolite2:download)
GeoLite2-City.mmdb
