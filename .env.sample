# Active Record Encryption (local dev only — auto-generated in production)
# Generate with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# SMTP settings (optional, can also be configured via the setup wizard)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com

# Polar (payments & subscriptions — local dev only, configured via admin panel in production)
# For local dev, use Polar Sandbox: https://sandbox.polar.sh
POLAR_SANDBOX=true
POLAR_ACCESS_TOKEN=
POLAR_BASIC_PRODUCT_ID=
POLAR_GROWTH_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Honeybadger error tracking (optional — set to enable in production)
HONEYBADGER_API_KEY=

# MaxMind GeoLite2 (required for IP geolocation in visit processing)
# Sign up: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Tailscale (optional — adds a Tailscale hostname to Rails allowed hosts in dev)
# TAILSCALE_HOST=your-machine.tailnet-name.ts.net

# Trial length in days on ugo.cr (managed main app only; cardless Basic trial)
# UGO_TRIAL_DURATION_DAYS=14

# Cloudflare Turnstile (managed ugo.cr sign-up only; optional locally — see Turnstile testing docs)
# CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Optional: CDN/proxy CIDRs for correct request.remote_ip in production (Once: Settings → Environment)
# Generate with: bin/rails trusted_proxies:cloudflare
# TRUSTED_PROXIES_EXTRA=173.245.48.0/20,...

# Log one client_ip line per request (cf_connecting_ip, x_forwarded_for, resolved IP)
# DEBUG_CLIENT_IP=true

# Concurrency (production / Once Environment). Pool defaults to max(RAILS_MAX_THREADS, SOLID_QUEUE_THREADS).
# WEB_CONCURRENCY=3
# RAILS_MAX_THREADS=5
# JOB_CONCURRENCY=2
# SOLID_QUEUE_THREADS=3
# DB_POOL=5
# SOLID_QUEUE_IN_PUMA=false
